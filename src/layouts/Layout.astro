---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { site, offices, services } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const { title, description = site.description, canonicalPath = "/" } = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = `${site.url}${canonicalPath}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LegalService",
  name: site.legalName,
  alternateName: site.name,
  url: site.url,
  email: site.email,
  telephone: `+${site.whatsapp}`,
  description: site.description,
  foundingDate: String(site.foundedYear),
  areaServed: { "@type": "Country", name: "México" },
  address: offices.map((o) => ({
    "@type": "PostalAddress",
    addressLocality: o.city,
    addressCountry: "MX",
  })),
  knowsLanguage: "es-MX",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Áreas de práctica",
    itemListElement: services.map((s) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: s.name, description: s.short },
      url: `${site.url}/servicios/${s.slug}/`,
    })),
  },
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/logo.png`} />
    <meta property="og:locale" content="es_MX" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&family=Inter:wght@300..700&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />

    <script is:inline set:html={JSON.stringify(jsonLd)} type="application/ld+json" />

    {/* Flag JS before first paint so reveal styles never hide content
        for users without scripts. */}
    <script is:inline>
      document.documentElement.classList.add("has-js");
      // Inline a propósito: un módulo puede fallar al descargarse, esto no.
      // Si el motor de movimiento no confirma en 5s, se muestra todo.
      window.__motionFailsafe = setTimeout(function () {
        document.documentElement.classList.add("motion-off");
      }, 5000);
    </script>
  </head>

  <body class="bg-bone text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-ink focus:text-bone focus:px-5 focus:py-3"
    >
      Saltar al contenido
    </a>

    <div id="scroll-progress" aria-hidden="true"></div>

    <Header />
    <main id="main" transition:animate="fade">
      <slot />
    </main>
    <Footer />

    <script>
      const REDUCED = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      /* ---------- Word split -------------------------------------------
         Wraps every word in a clipped box so text rises into view instead
         of fading. Walks the tree instead of touching textContent, so
         inline markup (<span class="italic">…) survives intact. ---------- */
      function splitWords(root) {
        if (root.dataset.splitDone) return;

        const wrap = (node) => {
          const frag = document.createDocumentFragment();
          node.textContent.split(/(\s+)/).forEach((chunk) => {
            if (!chunk) return;
            if (/^\s+$/.test(chunk)) {
              frag.appendChild(document.createTextNode(chunk));
              return;
            }
            const outer = document.createElement("span");
            outer.className = "split-line split-word";
            const inner = document.createElement("span");
            inner.className = "split-inner";
            inner.textContent = chunk;
            outer.appendChild(inner);
            frag.appendChild(outer);
          });
          node.replaceWith(frag);
        };

        const walk = (el) => {
          [...el.childNodes].forEach((n) => {
            if (n.nodeType === 3 && n.textContent.trim()) wrap(n);
            else if (n.nodeType === 1) walk(n);
          });
        };

        walk(root);
        root.querySelectorAll(".split-inner").forEach((el, i) => {
          el.style.setProperty("--split-delay", `${i * (Number(root.dataset.splitStep) || 42)}ms`);
        });
        root.dataset.splitDone = "1";
        root.classList.add("is-split");
      }

      /* ---------- Counters --------------------------------------------- */
      function countUp(el) {
        const target = Number(el.dataset.count);
        if (!Number.isFinite(target)) return;
        const dur = 1100;
        const t0 = performance.now();
        const tick = (now) => {
          const p = Math.min((now - t0) / dur, 1);
          // ease-out-quint, so it decelerates into the final number
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 5))));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

      function init() {
        const reveals = document.querySelectorAll("[data-reveal]");
        const splits = document.querySelectorAll("[data-split]");
        const counters = document.querySelectorAll("[data-count]");

        if (REDUCED || !("IntersectionObserver" in window)) {
          reveals.forEach((el) => el.classList.add("is-in"));
          splits.forEach((el) => el.classList.add("is-split", "is-in"));
          counters.forEach((el) => (el.textContent = el.dataset.count));
          return;
        }

        splits.forEach(splitWords);

        document.querySelectorAll("[data-reveal-stagger]").forEach((group) => {
          const step = Number(group.dataset.revealStagger) || 60;
          group.querySelectorAll("[data-reveal]").forEach((el, i) => {
            el.style.setProperty("--reveal-delay", `${i * step}ms`);
          });
        });

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target;
              el.classList.add("is-in");
              if (el.dataset.count !== undefined) countUp(el);
              io.unobserve(el);
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.05 }
        );

        [...reveals, ...splits, ...counters].forEach((el) => io.observe(el));

        // Failsafe: content must never be left invisible.
        window.setTimeout(() => {
          reveals.forEach((el) => el.classList.add("is-in"));
          splits.forEach((el) => el.classList.add("is-split", "is-in"));
        }, 4500);
      }

      /* ---------- Scroll-driven: progress bar + parallax ---------------- */
      function scrollFx() {
        const bar = document.getElementById("scroll-progress");
        const layers = document.querySelectorAll("[data-parallax]");
        if (!bar && !layers.length) return;

        let ticking = false;
        const frame = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          if (bar) bar.style.setProperty("--progress", max > 0 ? String(window.scrollY / max) : "0");

          if (!REDUCED) {
            const mid = window.innerHeight / 2;
            layers.forEach((el) => {
              const r = el.getBoundingClientRect();
              const speed = Number(el.dataset.parallax) || 0.06;
              el.style.setProperty("--par-y", `${(r.top + r.height / 2 - mid) * -speed}px`);
            });
          }
          ticking = false;
        };

        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(frame);
        };

        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
        frame();
      }

      // Re-run on every view transition, not just first load.
      document.addEventListener("astro:page-load", () => {
        clearTimeout(window.__motionFailsafe);
        init();
        scrollFx();
      });
    </script>
  </body>
</html>
