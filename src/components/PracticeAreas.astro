---
import { services } from "../data/site";
import Icon from "./Icon.astro";

const pad = (n: number) => String(n + 1).padStart(2, "0");
---

<section id="servicios" class="py-section">
  <div class="shell">
    <div class="max-w-2xl mb-16 lg:mb-20">
      <p class="eyebrow mb-5" data-reveal>Áreas de práctica</p>
      <h2 class="text-h2 font-light mb-5" data-split data-split-step="34">
        Defensa integral bajo un mismo techo.
      </h2>
      <p class="text-slate max-w-[52ch] leading-relaxed" data-reveal>
        Atendemos los frentes en los que se juega la operación cotidiana de
        contribuyentes y empresas: del SAT a la aduana, de la propiedad
        industrial al cumplimiento contable.
      </p>
    </div>

    <div class="grid lg:grid-cols-12 lg:gap-x-16" data-areas>
      <!-- ---- Panel fijo: cambia según la fila que estés leyendo ----
           Enhancement puro. Sin JS la lista de abajo ya trae todo. -->
      <div class="hidden lg:block lg:col-span-5" aria-hidden="true">
        <div class="sticky top-32 h-[26rem]">
          {services.map((s, i) => (
            <article
              class="absolute inset-0 transition-all duration-500 ease-out data-[active]:opacity-100 data-[active]:translate-y-0 opacity-0 translate-y-4 pointer-events-none"
              data-panel={i}
              data-active={i === 0 ? "" : undefined}
            >
              <div class="font-display text-[9rem] leading-[0.8] font-light text-gold-ink/15 select-none">
                {pad(i)}
              </div>
              <div class="text-gold-ink mt-8 mb-6">
                <Icon name={s.icon} size={46} stroke={1.1} />
              </div>
              <h3 class="text-h3 font-normal mb-4 max-w-[16ch]">{s.name}</h3>
              <p class="text-slate leading-relaxed max-w-[38ch]">{s.short}</p>
            </article>
          ))}
        </div>
      </div>

      <!-- ---- Lista recorrible ---- -->
      <ol class="lg:col-span-7 border-t border-mist">
        {services.map((s, i) => (
          <li class="border-b border-mist" data-area={i}>
            <a
              href={`/servicios/${s.slug}/`}
              class="group flex items-start gap-5 lg:gap-7 py-7 lg:py-9 transition-colors duration-300"
            >
              <span class="font-display text-sm tracking-[0.22em] text-gold-ink/70 pt-2 shrink-0 tnum">
                {pad(i)}
              </span>

              <span class="lg:hidden text-gold-ink pt-1 shrink-0">
                <Icon name={s.icon} size={26} stroke={1.25} />
              </span>

              <span class="min-w-0 flex-1">
                <span class="block font-display text-2xl lg:text-[2rem] font-normal leading-tight transition-transform duration-500 ease-out lg:group-hover:translate-x-2">
                  {s.name}
                </span>
                <span class="block text-[0.9375rem] text-slate leading-relaxed mt-2 max-w-[46ch]">
                  {s.short}
                </span>
              </span>

              <span class="shrink-0 self-center text-gold-ink opacity-0 -translate-x-2 transition-all duration-400 ease-out group-hover:opacity-100 group-hover:translate-x-0">
                <Icon name="arrow-right" size={22} stroke={1.4} />
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  // Sincroniza el panel fijo con la fila que está a la altura de lectura.
  // Se calcula por distancia a una línea fija del viewport en vez de con
  // IntersectionObserver: el callback de IO solo entrega las entradas que
  // cambiaron, no todas las visibles, y eso hacía saltar el panel.
  function syncAreas() {
    const scope = document.querySelector<HTMLElement>("[data-areas]");
    if (!scope) return;

    const rows = [...scope.querySelectorAll<HTMLElement>("[data-area]")];
    const panels = [...scope.querySelectorAll<HTMLElement>("[data-panel]")];
    if (!rows.length || !panels.length) return;

    let active = -1;
    let ticking = false;

    const frame = () => {
      ticking = false;
      if (!window.matchMedia("(min-width: 1024px)").matches) return;

      const line = window.innerHeight * 0.45;
      let best = 0;
      let bestDist = Infinity;

      rows.forEach((row, i) => {
        const r = row.getBoundingClientRect();
        const dist = Math.abs(r.top + r.height / 2 - line);
        if (dist < bestDist) {
          bestDist = dist;
          best = i;
        }
      });

      if (best === active) return;
      active = best;
      panels.forEach((p, n) => p.toggleAttribute("data-active", n === best));
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(frame);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    frame();
  }

  document.addEventListener("astro:page-load", syncAreas);
</script>
