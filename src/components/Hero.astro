---
import { site } from "../data/site";
---

<section class="relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-bone via-bone-warm to-bone pointer-events-none"></div>
  <div class="absolute -top-32 -right-32 w-96 h-96 bg-gold/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative container-prose py-20 lg:py-28 grid gap-12 lg:grid-cols-12 items-center">
    <div class="lg:col-span-7">
      <p class="eyebrow mb-5">Firma fundada en {site.foundedYear}</p>
      <h1 class="text-5xl md:text-6xl lg:text-7xl leading-[1.05] mb-6">
        Defensa legal y contable<br />
        <span class="italic text-gold-dark">para quien la necesita.</span>
      </h1>
      <p class="text-lg md:text-xl text-slate leading-relaxed max-w-2xl mb-8">
        Controvertimos créditos fiscales, multas y procedimientos administrativos
        ante el SAT, IMSS, INFONAVIT, IMPI y autoridades aduaneras a nivel nacional.
        Acompañamos a contribuyentes y empresariado con estrategia, no con improvisación.
      </p>

      <div class="flex flex-wrap gap-3">
        <a href="/contacto/" class="btn-primary">
          Solicita una asesoría
          <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor">
            <path d="M8.5 3.5l4 4-4 4M3 7.5h9" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" />
          </svg>
        </a>
        <a
          href={`https://wa.me/${site.whatsapp}`}
          class="btn-secondary"
          target="_blank"
          rel="noopener"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.768.967-.94 1.165-.173.198-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          WhatsApp
        </a>
      </div>

      <div class="mt-10 grid grid-cols-3 gap-6 max-w-xl">
        <div>
          <div class="font-display text-3xl text-gold-dark">15+</div>
          <div class="text-xs text-slate uppercase tracking-wider mt-1">años de experiencia</div>
        </div>
        <div>
          <div class="font-display text-3xl text-gold-dark">8</div>
          <div class="text-xs text-slate uppercase tracking-wider mt-1">áreas de práctica</div>
        </div>
        <div>
          <div class="font-display text-3xl text-gold-dark">MX</div>
          <div class="text-xs text-slate uppercase tracking-wider mt-1">cobertura nacional</div>
        </div>
      </div>
    </div>

    <div class="lg:col-span-5">
      <div class="relative">
        <div class="absolute inset-0 bg-gold/15 blur-3xl"></div>
        <div class="relative bg-ink text-bone p-10 lg:p-12">
          <div class="gold-rule mb-6"></div>
          <p class="eyebrow text-gold-light mb-3">Respaldo institucional</p>
          <h2 class="font-display text-3xl text-bone mb-5 leading-tight">
            Doble visión:<br />
            <span class="text-gold">defensor</span> y <span class="text-gold">juzgador</span>.
          </h2>
          <p class="text-bone/75 text-sm leading-relaxed mb-6">
            Nuestra dirección combina experiencia del lado del contribuyente
            (PRODECON, en Chihuahua y la Zona Norte) y del lado del juzgador
            (Tribunal Federal de Justicia Fiscal y Administrativa).
          </p>
          <p class="text-bone/75 text-sm leading-relaxed">
            Esa perspectiva poco común nos permite anticipar criterios y construir
            argumentos que la autoridad y el tribunal sí escuchan.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
