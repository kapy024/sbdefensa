---
import { site, figures, authorities } from "../data/site";
import Icon from "./Icon.astro";

const waHref = `https://wa.me/${site.whatsapp}`;
---

<section class="relative overflow-hidden">
  <!-- Warm wash + a faint column grid: the page reads as a printed sheet. -->
  <div class="absolute inset-0 -z-10 paper-panel"></div>
  <div
    class="absolute inset-0 -z-10 hidden lg:block opacity-[0.55]"
    style="background-image: repeating-linear-gradient(to right, transparent 0 calc(12.5% - 1px), var(--color-mist) calc(12.5% - 1px) 12.5%); mask-image: linear-gradient(to bottom, transparent, black 18%, black 72%, transparent);"
  >
  </div>

  <div class="shell relative pt-16 pb-14 lg:pt-24 lg:pb-20">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-x-14 items-start">
      <!-- ---------------- Statement ---------------- -->
      <div class="lg:col-span-7" data-reveal-stagger="90">
        <p class="eyebrow mb-7" data-reveal>Firma fundada en {site.foundedYear}</p>

        <h1 class="text-display font-light mb-8 max-w-[13ch]" data-reveal>
          Defensa legal y contable
          <span class="block italic font-normal text-gold-ink">para quien la necesita.</span>
        </h1>

        <p class="text-lead text-slate max-w-[46ch] mb-9" data-reveal>
          Controvertimos créditos fiscales, multas y procedimientos administrativos
          ante el SAT, IMSS, INFONAVIT, IMPI y autoridades aduaneras a nivel nacional.
          Acompañamos a contribuyentes y empresariado con estrategia, no con improvisación.
        </p>

        <div class="flex flex-wrap gap-3" data-reveal>
          <a href="/contacto/" class="btn btn-primary">
            Solicita una asesoría
            <Icon name="arrow-right" size={17} stroke={1.5} />
          </a>
          <a href={waHref} target="_blank" rel="noopener" class="btn btn-ghost">
            <Icon name="whatsapp" size={17} />
            WhatsApp directo
          </a>
        </div>

        <p class="mt-6 flex items-center gap-2.5 text-sm text-slate" data-reveal>
          <Icon name="clock" size={16} stroke={1.3} class="text-gold-ink" />
          Primera valoración del caso sin costo
        </p>
      </div>

      <!-- ---------------- Dossier ---------------- -->
      <aside class="lg:col-span-5 lg:pt-3" data-reveal>
        <div class="on-ink ink-panel text-bone p-9 lg:p-11 shadow-ink">
          <div class="flex items-center justify-between mb-8">
            <p class="eyebrow">Respaldo institucional</p>
            <span class="font-display text-xs tracking-[0.3em] text-bone/60">01</span>
          </div>

          <h2 class="font-display text-h3 text-bone leading-tight mb-7">
            Doble visión:<br />
            <span class="text-gold italic">defensor</span>
            <span class="text-bone/60">y</span>
            <span class="text-gold italic">juzgador</span>.
          </h2>

          <div class="rule-gold mb-7"></div>

          <p class="text-bone/70 text-[0.9375rem] leading-relaxed mb-5">
            Nuestra dirección combina experiencia del lado del contribuyente
            (PRODECON, en Chihuahua y la Zona Norte) y del lado del juzgador
            (Tribunal Federal de Justicia Fiscal y Administrativa).
          </p>
          <p class="text-bone/70 text-[0.9375rem] leading-relaxed">
            Esa perspectiva poco común nos permite anticipar criterios y construir
            argumentos que la autoridad y el tribunal sí escuchan.
          </p>

          <a
            href="/nosotros/"
            class="link-line inline-flex items-center gap-2 mt-8 text-sm text-gold-light"
          >
            Conoce a la dirección
            <Icon name="arrow-up-right" size={15} stroke={1.5} />
          </a>
        </div>
      </aside>
    </div>
  </div>

  <!-- ---------------- Ledger of figures ---------------- -->
  <div class="shell relative">
    <div class="grid grid-cols-2 lg:grid-cols-4 border-t border-mist" data-reveal-stagger="70">
      {figures.map((f, i) => (
        <div
          class:list={[
            "py-7 lg:py-9 lg:px-8 first:lg:pl-0",
            i % 2 === 1 && "pl-6 border-l border-mist",
            i >= 2 && "border-t border-mist lg:border-t-0",
            i === 2 && "lg:border-l lg:border-mist",
            i === 3 && "lg:border-l lg:border-mist",
          ]}
          data-reveal
        >
          <div class="font-display text-4xl lg:text-5xl font-light text-ink leading-none">
            {f.value}<span class="text-gold-ink">{f.suffix}</span>
          </div>
          <div class="text-[0.6875rem] uppercase tracking-[0.16em] text-slate mt-3">
            {f.label}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- ---------------- Authorities ---------------- -->
  <div class="border-y border-mist bg-bone/60">
    <div class="shell py-7">
      <p class="text-[0.6875rem] uppercase tracking-[0.2em] text-slate mb-5">
        Litigamos ante
      </p>
      <ul class="flex flex-wrap items-center gap-x-8 gap-y-3.5">
        {authorities.map((a) => (
          <li>
            <abbr
              title={a.full}
              class="font-display text-xl lg:text-2xl tracking-[0.06em] text-ink/55 no-underline hover:text-ink transition-colors duration-300"
            >
              {a.abbr}
            </abbr>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
