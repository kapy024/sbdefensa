---
import { site, deadlines } from "../data/site";
import Icon from "./Icon.astro";

const waHref = `https://wa.me/${site.whatsapp}`;

// Unsplash: "minimalist photography of hallway between columns".
// Licencia Unsplash — uso libre. Se cambia por foto propia sin tocar layout.
const heroImg = "https://images.unsplash.com/photo-1519674921880-e784bc34ebd4?auto=format&fit=crop&w=2400&q=75";
const heroImgSm = "https://images.unsplash.com/photo-1519674921880-e784bc34ebd4?auto=format&fit=crop&w=1000&q=70";
---

<section class="hero relative isolate min-h-[100svh] flex flex-col justify-end overflow-hidden bg-ink text-paper">
  <!-- Fotografía a sangre con duotono verde-tinta. Ella es el hero. -->
  <figure class="hero-media absolute inset-0 -z-10 m-0" aria-hidden="true">
    <img
      src={heroImg}
      srcset={`${heroImgSm} 1000w, ${heroImg} 2400w`}
      sizes="100vw"
      alt=""
      width="2400"
      height="1600"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="hero-img h-full w-full object-cover object-[60%_center] grayscale contrast-[1.08] brightness-[0.92]"
    />
    <!-- Duotono: `color` tiñe de verde sin tocar la luz de la foto; el
         oscurecido solo entra abajo, donde vive el texto. -->
    <div class="absolute inset-0 bg-forest mix-blend-color"></div>
    <div class="absolute inset-0 bg-ink mix-blend-multiply opacity-35"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_top,var(--color-ink)_0%,color-mix(in_srgb,var(--color-ink)_70%,transparent)_28%,transparent_62%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(50%_45%_at_78%_22%,color-mix(in_srgb,var(--color-bronze)_30%,transparent),transparent_70%)] mix-blend-screen"></div>
  </figure>

  <div class="shell relative pt-28 pb-10 lg:pb-14">
    <p class="hero-eyebrow font-mono text-[0.75rem] tracking-[0.18em] uppercase text-bronze-light mb-8">
      {site.tagline} <span class="text-paper/40 mx-2">/</span> {site.coverage}
    </p>

    <h1 class="hero-title text-display font-display font-normal text-paper max-w-[12ch] mb-8">
      Recibiste una notificación.
      <span class="block italic text-bronze-light">El plazo ya corre.</span>
    </h1>

    <div class="hero-body grid gap-8 lg:grid-cols-12 lg:gap-x-12 items-end">
      <p class="lg:col-span-6 text-lead text-paper/80 max-w-[48ch]">
        Controvertimos créditos fiscales, multas y procedimientos ante el SAT,
        IMSS, INFONAVIT, IMPI y aduanas en toda la República. Estrategia desde
        el primer día, no improvisación.
      </p>
      <div class="lg:col-span-6 flex flex-wrap gap-3 lg:justify-end">
        <a href="/contacto/" class="btn bg-bronze text-ink border-bronze hover:bg-bronze-light hover:border-bronze-light">
          Solicita una asesoría
          <Icon name="arrow-right" size={17} stroke={1.5} />
        </a>
        <a href={waHref} target="_blank" rel="noopener" class="btn bg-transparent text-paper border-paper/35 hover:bg-paper hover:text-ink hover:border-paper">
          <Icon name="whatsapp" size={17} />
          WhatsApp directo
        </a>
      </div>
    </div>
  </div>

  <!-- Pieza firma: los plazos. Información real, no decoración. -->
  <div class="hero-ticker texture-marble relative border-t border-paper/15 bg-ink/70 backdrop-blur-sm overflow-hidden">
    <div class="marquee [mask-image:linear-gradient(90deg,transparent,black_5%,black_95%,transparent)]">
      <div class="marquee-track" style="--marquee-duration: 44s">
        {[0, 1].map((copy) => (
          <ul class="flex items-stretch" aria-hidden={copy === 1 ? "true" : undefined}>
            {deadlines.map((d) => (
              <li class="flex items-baseline gap-4 px-8 py-5 border-r border-paper/10 font-mono text-[0.8125rem] whitespace-nowrap">
                <span class="text-bronze-light text-[1.5rem] leading-none tabular-nums">{d.days}</span>
                <span class="text-paper/50 uppercase tracking-[0.14em] text-[0.6875rem]">días hábiles</span>
                <span class="text-paper">{d.action}</span>
                <span class="text-paper/40">· {d.vs}</span>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(ScrollTrigger, SplitText);

  function heroMotion() {
    const hero = document.querySelector<HTMLElement>(".hero");
    if (!hero) return;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const img = hero.querySelector<HTMLElement>(".hero-img");
    const title = hero.querySelector<HTMLElement>(".hero-title");
    const rest = hero.querySelectorAll<HTMLElement>(".hero-eyebrow, .hero-body, .hero-ticker");
    if (!img || !title) return;

    if (reduced) return;

    // Entrada: la foto se asienta y el titular sube línea por línea desde
    // una máscara. SplitText es gratis desde GSAP 3.13.
    const split = SplitText.create(title, { type: "lines", mask: "lines", linesClass: "hero-line" });
    // La máscara recorta al alto de línea; los descendentes (y, p, g) piden
    // aire abajo. Se compensa con margen negativo para no abrir la línea.
    split.masks?.forEach((m) => {
      m.style.paddingBottom = "0.14em";
      m.style.marginBottom = "-0.14em";
    });
    const tl = gsap.timeline({ defaults: { ease: "expo.out" } });
    tl.fromTo(img, { scale: 1.14 }, { scale: 1, duration: 2.2 }, 0)
      .from(split.lines, { yPercent: 110, duration: 1.4, stagger: 0.12 }, 0.25)
      .from(rest, { y: 24, autoAlpha: 0, duration: 1.1, stagger: 0.12 }, 0.7);

    // Scroll: la foto se queda atrás, el texto sale antes. Profundidad real.
    gsap.to(img, {
      yPercent: 16, scale: 1.06, ease: "none",
      scrollTrigger: { trigger: hero, start: "top top", end: "bottom top", scrub: true },
    });
    gsap.to(title, {
      yPercent: -22, autoAlpha: 0.15, ease: "none",
      scrollTrigger: { trigger: hero, start: "top top", end: "bottom top", scrub: true },
    });
  }

  document.addEventListener("astro:page-load", heroMotion);
</script>
