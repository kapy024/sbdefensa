---
import { site, figures, authorities } from "../data/site";
import Icon from "./Icon.astro";
import Seal from "./Seal.astro";
import MeshBackdrop from "./MeshBackdrop.astro";

const waHref = `https://wa.me/${site.whatsapp}`;
---

<section class="relative overflow-hidden">
  <MeshBackdrop />

  <Seal class="pointer-events-none absolute -z-[5] hidden lg:block w-[38rem] h-[38rem] right-[-7rem] top-[8rem] opacity-40" />

  <div class="shell relative pt-20 pb-16 lg:pt-28 lg:pb-20">
    <p class="eyebrow mb-9" data-reveal>Firma fundada en {site.foundedYear}</p>

    <h1 class="text-display font-light relative z-10 mb-10 lg:mb-12" data-split data-split-step="46">
      <span class="block">Defensa legal</span>
      <span class="block lg:pl-[5vw]">y contable</span>
      <span class="block lg:pl-[11vw] italic font-normal text-gold-ink">para quien la necesita.</span>
    </h1>

    <div class="grid gap-10 lg:grid-cols-12 lg:gap-x-12 items-end">
      <p class="lg:col-span-6 text-lead text-slate max-w-[52ch]" data-reveal>
        Controvertimos créditos fiscales, multas y procedimientos administrativos
        ante el SAT, IMSS, INFONAVIT, IMPI y autoridades aduaneras a nivel nacional.
        Acompañamos a contribuyentes y empresariado con estrategia, no con improvisación.
      </p>

      <div class="lg:col-span-6 flex flex-wrap items-center gap-3" data-reveal>
        <a href="/contacto/" class="btn btn-primary">
          Solicita una asesoría
          <Icon name="arrow-right" size={17} stroke={1.5} />
        </a>
        <a href={waHref} target="_blank" rel="noopener" class="btn btn-ghost">
          <Icon name="whatsapp" size={17} />
          WhatsApp directo
        </a>
        <p class="w-full flex items-center gap-2.5 text-sm text-slate mt-1">
          <Icon name="clock" size={16} stroke={1.3} class="text-gold-ink" />
          Primera valoración del caso sin costo
        </p>
      </div>
    </div>

    <!-- El respaldo institucional deja de ser una tarjeta negra: vive en el
         flujo, como una nota editorial sobre el mismo papel. -->
    <div
      class="mt-16 lg:mt-20 grid gap-6 lg:grid-cols-12 lg:gap-x-12 border-t border-ink/10 pt-10"
      data-reveal
    >
      <p class="eyebrow lg:col-span-3">Respaldo institucional</p>

      <div class="lg:col-span-9">
        <p class="font-display text-[1.65rem] lg:text-[2.25rem] font-light leading-tight mb-5">
          Doble visión:
          <span class="italic text-gold-ink">defensor</span>
          <span class="text-slate">y</span>
          <span class="italic text-gold-ink">juzgador</span>.
        </p>
        <p class="text-slate leading-relaxed max-w-[64ch]">
          Nuestra dirección combina experiencia del lado del contribuyente
          (PRODECON, en Chihuahua y la Zona Norte) y del lado del juzgador
          (Tribunal Federal de Justicia Fiscal y Administrativa). Esa perspectiva
          poco común nos permite anticipar criterios y construir argumentos que
          la autoridad y el tribunal sí escuchan.
        </p>
        <a href="/nosotros/" class="link-line inline-flex items-center gap-2 mt-6 text-sm text-gold-ink font-medium">
          Conoce a la dirección
          <Icon name="arrow-up-right" size={15} stroke={1.5} />
        </a>
      </div>
    </div>
  </div>

  <!-- ---------------- Ledger of figures ---------------- -->
  <div class="shell relative">
    <div class="grid grid-cols-2 lg:grid-cols-4 border-t border-ink/10" data-reveal-stagger="70">
      {figures.map((f, i) => (
        <div
          class:list={[
            "py-7 lg:py-9 lg:px-8 first:lg:pl-0",
            i % 2 === 1 && "pl-6 border-l border-ink/10",
            i >= 2 && "border-t border-ink/10 lg:border-t-0",
            i === 2 && "lg:border-l lg:border-ink/10",
            i === 3 && "lg:border-l lg:border-ink/10",
          ]}
          data-reveal
        >
          <div class="font-display text-4xl lg:text-5xl font-light text-ink leading-none">
            <span data-count={f.value}>0</span><span class="text-gold-ink">{f.suffix}</span>
          </div>
          <div class="text-[0.6875rem] uppercase tracking-[0.16em] text-slate mt-3">
            {f.label}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- ---------------- Authorities ---------------- -->
  <div class="border-y border-ink/10 overflow-hidden">
    <div class="shell pt-7 pb-3">
      <p class="text-[0.6875rem] uppercase tracking-[0.2em] text-slate">Litigamos ante</p>
    </div>

    <div class="marquee pb-7 [mask-image:linear-gradient(90deg,transparent,black_6%,black_94%,transparent)]">
      <div class="marquee-track" style="--marquee-duration: 52s">
        {[0, 1].map((copy) => (
          <ul class="flex items-center gap-x-12 pr-12" aria-hidden={copy === 1 ? "true" : undefined}>
            {authorities.map((a) => (
              <li class="shrink-0">
                <abbr
                  title={a.full}
                  class="font-display text-2xl lg:text-[1.75rem] tracking-[0.06em] text-ink/55 no-underline hover:text-ink transition-colors duration-300"
                >
                  {a.abbr}
                </abbr>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>
