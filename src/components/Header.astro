---
import { site, services } from "../data/site";
---

<header class="sticky top-0 z-40 bg-bone/85 backdrop-blur border-b border-mist">
  <div class="container-prose flex items-center justify-between py-4 gap-6">
    <a href="/" class="flex items-center gap-3 group" aria-label={site.name}>
      <img src="/logo.png" alt="" class="h-10 w-auto" />
      <span class="sr-only">{site.legalName}</span>
    </a>

    <nav aria-label="Principal" class="hidden md:flex items-center gap-7 text-sm">
      <a href="/" class="hover:text-gold-dark transition-colors">Inicio</a>
      <div class="relative group">
        <button
          class="hover:text-gold-dark transition-colors flex items-center gap-1"
          aria-haspopup="true"
        >
          Servicios
          <svg class="w-3 h-3" viewBox="0 0 12 12" fill="currentColor">
            <path d="M6 8L2 4h8z" />
          </svg>
        </button>
        <div
          class="absolute right-0 top-full pt-3 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all"
        >
          <div class="w-72 bg-bone border border-mist shadow-elevated p-2">
            {services.map((s) => (
              <a
                href={`/servicios/${s.slug}/`}
                class="flex items-start gap-3 px-3 py-2.5 hover:bg-bone-warm transition-colors"
              >
                <span class="text-lg leading-none mt-0.5">{s.icon}</span>
                <div>
                  <div class="font-medium text-sm">{s.name}</div>
                  <div class="text-xs text-slate mt-0.5 leading-snug">{s.short}</div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
      <a href="/nosotros/" class="hover:text-gold-dark transition-colors">Nosotros</a>
      <a href="/contacto/" class="hover:text-gold-dark transition-colors">Contacto</a>
    </nav>

    <a href="/contacto/" class="hidden md:inline-flex btn-primary text-sm">
      Asesoría
    </a>

    <button
      type="button"
      id="menu-toggle"
      class="md:hidden p-2 -mr-2"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-mist bg-bone">
    <nav class="container-prose py-4 flex flex-col gap-1 text-sm">
      <a href="/" class="py-2">Inicio</a>
      <details class="group">
        <summary class="py-2 cursor-pointer flex items-center justify-between">
          Servicios
          <span class="group-open:rotate-180 transition-transform">▾</span>
        </summary>
        <div class="pl-4 pb-2 flex flex-col">
          {services.map((s) => (
            <a href={`/servicios/${s.slug}/`} class="py-1.5 text-slate">
              {s.name}
            </a>
          ))}
        </div>
      </details>
      <a href="/nosotros/" class="py-2">Nosotros</a>
      <a href="/contacto/" class="py-2">Contacto</a>
      <a href="/contacto/" class="btn-primary justify-center mt-3">Solicita asesoría</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!open));
  });
</script>
