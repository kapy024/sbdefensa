---
import { site, services } from "../data/site";
import Icon from "./Icon.astro";

const waHref = `https://wa.me/${site.whatsapp}`;
const nav = [
  { href: "/nosotros/", label: "Nosotros" },
  { href: "/contacto/", label: "Contacto" },
];
---

<!-- Utility strip: contact always one glance away on desktop. -->
<div class="hidden lg:block bg-parchment-deep/70 border-b border-ink/10 text-slate text-xs">
  <div class="shell flex items-center justify-between h-9">
    <p class="tracking-[0.14em] uppercase text-[0.6875rem]">
      {site.coverage} · Sedes en {site.location}
    </p>
    <div class="flex items-center gap-6">
      <a href={`mailto:${site.email}`} class="flex items-center gap-2 hover:text-bronze-ink transition-colors">
        <Icon name="mail" size={14} stroke={1.3} />
        {site.email}
      </a>
      <a href={waHref} target="_blank" rel="noopener" class="flex items-center gap-2 hover:text-bronze-ink transition-colors">
        <Icon name="whatsapp" size={13} />
        {site.whatsappDisplay}
      </a>
    </div>
  </div>
</div>

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-line/70 bg-paper/80 backdrop-blur-md transition-shadow duration-300"
>
  <div class="shell flex items-center justify-between gap-6 h-[4.5rem] lg:h-20">
    <a href="/" class="flex items-center shrink-0" aria-label={`${site.name} — inicio`}>
      <img src="/logo.png" alt="" width="180" height="48" class="h-9 lg:h-11 w-auto" />
      <span class="sr-only">{site.legalName}</span>
    </a>

    <nav aria-label="Principal" class="hidden md:flex items-center gap-8 text-sm">
      <a href="/" class="link-line py-2">Inicio</a>

      <div class="relative" data-menu>
        <button
          type="button"
          class="link-line py-2 flex items-center gap-1.5 cursor-pointer"
          aria-expanded="false"
          aria-controls="services-menu"
          data-menu-trigger
        >
          Servicios
          <Icon name="chevron-down" size={14} stroke={1.6} class="transition-transform duration-300 [[aria-expanded=true]_&]:rotate-180" />
        </button>

        <div
          id="services-menu"
          data-menu-panel
          hidden
          class="absolute right-0 top-full pt-4 w-[min(38rem,calc(100vw-3rem))]"
        >
          <div class="bg-paper border border-line shadow-lift p-2 grid sm:grid-cols-2 gap-0.5">
            {services.map((s) => (
              <a
                href={`/servicios/${s.slug}/`}
                class="group flex items-start gap-3.5 p-3 hover:bg-parchment transition-colors"
              >
                <span class="mt-0.5 text-bronze-ink transition-transform duration-300 group-hover:-translate-y-0.5">
                  <Icon name={s.icon} size={22} />
                </span>
                <span>
                  <span class="block font-medium text-sm leading-snug">{s.name}</span>
                  <span class="block text-xs text-slate mt-1 leading-snug">{s.short}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>

      {nav.map((n) => <a href={n.href} class="link-line py-2">{n.label}</a>)}
    </nav>

    <div class="hidden md:flex items-center gap-2">
      <a href={waHref} target="_blank" rel="noopener" class="btn btn-ghost !min-h-11 !px-4" aria-label="Escribir por WhatsApp">
        <Icon name="whatsapp" size={17} />
      </a>
      <a href="/contacto/" class="btn btn-primary !min-h-11 text-sm">Solicita asesoría</a>
    </div>

    <button
      type="button"
      id="menu-toggle"
      class="md:hidden -mr-2 p-2 cursor-pointer"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" size={26} stroke={1.5} />
    </button>
  </div>
</header>

<!-- Mobile drawer -->
<div
  id="mobile-menu"
  hidden
  class="md:hidden fixed inset-0 z-[60] bg-paper flex flex-col"
>
  <div class="shell flex items-center justify-between h-[4.5rem] border-b border-line">
    <img src="/logo.png" alt="" width="180" height="48" class="h-9 w-auto" />
    <button type="button" id="menu-close" class="-mr-2 p-2 cursor-pointer" aria-label="Cerrar menú">
      <Icon name="close" size={24} stroke={1.5} />
    </button>
  </div>

  <nav aria-label="Principal (móvil)" class="shell flex-1 overflow-y-auto py-8">
    <a href="/" class="block font-display text-3xl py-3">Inicio</a>

    <p class="eyebrow mt-8 mb-4">Áreas de práctica</p>
    <ul class="grid gap-0.5">
      {services.map((s) => (
        <li>
          <a href={`/servicios/${s.slug}/`} class="flex items-center gap-3.5 py-3">
            <span class="text-bronze-ink"><Icon name={s.icon} size={20} /></span>
            <span class="text-[0.9375rem]">{s.name}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-8 pt-6 border-t border-line grid gap-1">
      {nav.map((n) => <a href={n.href} class="font-display text-3xl py-3">{n.label}</a>)}
    </div>
  </nav>

  <div class="shell pb-8 pt-4 border-t border-line grid gap-3">
    <a href="/contacto/" class="btn btn-primary w-full">Solicita asesoría</a>
    <a href={waHref} target="_blank" rel="noopener" class="btn btn-ghost w-full">
      <Icon name="whatsapp" size={17} /> WhatsApp {site.whatsappDisplay}
    </a>
  </div>
</div>

<script>
  /* ---------- Services dropdown ---------- */
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  const trigger = menu?.querySelector<HTMLButtonElement>("[data-menu-trigger]");
  const panel = menu?.querySelector<HTMLElement>("[data-menu-panel]");

  if (menu && trigger && panel) {
    const setOpen = (open: boolean) => {
      trigger.setAttribute("aria-expanded", String(open));
      panel.hidden = !open;
    };

    trigger.addEventListener("click", () => {
      setOpen(trigger.getAttribute("aria-expanded") !== "true");
    });

    // Hover is a convenience on precise pointers only; click still works.
    if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      let closeTimer: number;
      menu.addEventListener("pointerenter", () => {
        window.clearTimeout(closeTimer);
        setOpen(true);
      });
      menu.addEventListener("pointerleave", () => {
        closeTimer = window.setTimeout(() => setOpen(false), 140);
      });
    }

    // Escape and focus-out close it; Escape returns focus to the trigger.
    menu.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && trigger.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        trigger.focus();
      }
    });
    menu.addEventListener("focusout", (e) => {
      if (!menu.contains(e.relatedTarget as Node)) setOpen(false);
    });
    document.addEventListener("click", (e) => {
      if (!menu.contains(e.target as Node)) setOpen(false);
    });
  }

  /* ---------- Mobile drawer ---------- */
  const toggle = document.getElementById("menu-toggle");
  const drawer = document.getElementById("mobile-menu");
  const closeBtn = document.getElementById("menu-close");

  const setDrawer = (open: boolean) => {
    if (!drawer || !toggle) return;
    drawer.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
    if (open) closeBtn?.focus();
    else toggle.focus();
  };

  toggle?.addEventListener("click", () => setDrawer(true));
  closeBtn?.addEventListener("click", () => setDrawer(false));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && drawer && !drawer.hidden) setDrawer(false);
  });
  drawer?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => setDrawer(false))
  );

  /* ---------- Header elevation on scroll ---------- */
  const header = document.getElementById("site-header");
  if (header) {
    const sync = () => header.classList.toggle("shadow-soft", window.scrollY > 8);
    sync();
    window.addEventListener("scroll", sync, { passive: true });
  }
</script>
