---
/**
 * SBDefensa icon set.
 * Hand-drawn line icons on a 24x24 grid, 1.4 stroke, mitred joins and butt
 * caps. Deliberately angular — reads institutional rather than friendly.
 * Replaces the emoji that used to stand in for service/audience icons.
 */
interface Props {
  name: string;
  size?: number;
  stroke?: number;
  class?: string;
}

const { name, size = 24, stroke = 1.4, class: className = "" } = Astro.props;

const icons: Record<string, string> = {
  /* ---- Áreas de práctica ---- */
  scale: `
    <path d="M12 3.2v17.6M7.4 20.8h9.2M3 7.6h18M12 7.6 12 4.6"/>
    <path d="M3 7.6 .8 13.2h4.4zM21 7.6l-2.2 5.6h4.4z"/>
    <circle cx="12" cy="3.6" r="1.1"/>`,
  ledger: `
    <path d="M5 2.8h8.6L19 8.2V21.2H5zM13.6 2.8v5.4H19"/>
    <path d="M8.8 17.6v-3.4M11.8 17.6v-5.6M14.8 17.6v-2.2"/>`,
  freight: `
    <path d="M2.4 16.4h19.2l-2.3 4.8H4.7z"/>
    <path d="M5.8 16.4V10.6h12.4v5.8M11.6 10.6V7.2h4.2v3.4M11.6 7.2V4.8"/>`,
  shield: `
    <path d="M12 2.6 4.2 5.4v6.2c0 4.9 3.3 8.4 7.8 9.8 4.5-1.4 7.8-4.9 7.8-9.8V5.4z"/>
    <path d="m8.7 11.7 2.4 2.4 4.2-4.8"/>`,
  building: `
    <path d="M3.8 21.2V3.4h10.6v17.8M14.4 21.2V9.6h5.8v11.6M2 21.2h20"/>
    <path d="M6.8 7.2h4.6M6.8 11.2h4.6M6.8 15.2h4.6M17 13.2h.02M17 17.2h.02"/>`,
  seal: `
    <circle cx="12" cy="9.4" r="6.4"/>
    <path d="M9.4 6.8h5.2M12 6.8v5.6"/>
    <path d="m8.6 15 -1.2 6.4 4.6-2.4 4.6 2.4L15.4 15"/>`,
  lock: `
    <path d="M5.6 10.2h12.8v10.6H5.6z"/>
    <path d="M8.6 10.2V6.8a3.4 3.4 0 0 1 6.8 0v3.4M12 14.2v2.8"/>`,
  clipboard: `
    <path d="M8.6 4.4H6.2v16.8h11.6V4.4h-2.4"/>
    <path d="M9 2.6h6v3.4H9zM9.4 11h5.2M9.4 14.6h5.2M9.4 18.2h3"/>`,

  /* ---- Audiencias ---- */
  person: `
    <circle cx="12" cy="8.2" r="3.9"/>
    <path d="M4.4 20.8c1.3-3.7 4-5.6 7.6-5.6s6.3 1.9 7.6 5.6"/>`,
  storefront: `
    <path d="M3 9.4 4.8 3.8h14.4L21 9.4M3 9.4h18M4.6 9.4v11.4h14.8V9.4"/>
    <path d="M9.4 20.8v-6.4h5.2v6.4"/>`,
  columns: `
    <path d="M2.2 9.4 12 3.6l9.8 5.8M2.2 21h19.6M3.8 18h16.4"/>
    <path d="M5.6 9.6V18M10 9.6V18M14 9.6V18M18.4 9.6V18"/>`,
  globe: `
    <circle cx="12" cy="12" r="9"/>
    <path d="M3 12h18"/>
    <path d="M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"/>`,
};

const ui: Record<string, string> = {
  "arrow-right": `<path d="M4 12h15M13.4 6.2 19.6 12l-6.2 5.8"/>`,
  "arrow-up-right": `<path d="M7 17 17 7M8.6 7H17v8.4"/>`,
  "chevron-down": `<path d="m6.5 9.5 5.5 5.5 5.5-5.5"/>`,
  mail: `<path d="M2.8 5.4h18.4v13.2H2.8zM2.8 6.2 12 13l9.2-6.8"/>`,
  pin: `<path d="M12 21.4c4.2-4.6 6.3-8 6.3-10.6a6.3 6.3 0 1 0-12.6 0c0 2.6 2.1 6 6.3 10.6Z"/><circle cx="12" cy="10.6" r="2.4"/>`,
  check: `<path d="m4.6 12.6 4.8 4.8L19.4 7.2"/>`,
  plus: `<path d="M12 5v14M5 12h14"/>`,
  menu: `<path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17"/>`,
  close: `<path d="m5.5 5.5 13 13M18.5 5.5l-13 13"/>`,
  clock: `<circle cx="12" cy="12" r="9"/><path d="M12 6.8V12l3.6 2.2"/>`,
  gavel: `<path d="m13.6 3.4 7 7M17.1 6.9 10.2 13.8M9.5 5.2 12.3 8M6.2 8.5 9 11.3M3 21h9.4M7.8 9.7 2.9 14.6a2 2 0 0 0 2.8 2.8l4.9-4.9"/>`,
};

/* WhatsApp is a brand mark: filled glyph, not part of the line set. */
const brand: Record<string, string> = {
  whatsapp: `<path fill="currentColor" stroke="none" d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.53.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.66-1.61-.91-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.03 1.02-1.03 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.42.25-.69.25-1.28.18-1.41-.08-.12-.28-.2-.57-.34M12.05 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26C2.16 6.45 6.6 2.01 12.05 2.01c2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.43 9.89-9.88 9.89m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.69 1.45c6.55 0 11.89-5.34 11.89-11.9 0-3.17-1.24-6.16-3.48-8.4Z"/>`,
};

const registry = { ...icons, ...ui, ...brand };
const markup = registry[name];

if (!markup) {
  throw new Error(
    `Icon "${name}" no existe. Disponibles: ${Object.keys(registry).join(", ")}`
  );
}

const isBrand = name in brand;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke={isBrand ? "none" : "currentColor"}
  stroke-width={stroke}
  stroke-linecap="butt"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={markup}
/>
