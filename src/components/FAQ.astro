---
import { faq } from "../data/site";
import Icon from "./Icon.astro";
---

<section class="py-section bg-parchment">
  <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-x-16">
    <div class="lg:col-span-4" data-reveal>
      <p class="eyebrow mb-5">Preguntas frecuentes</p>
      <h2 data-split data-split-step="34" class="text-h2 font-light mb-6">Lo que más nos preguntan.</h2>
      <p class="text-slate leading-relaxed text-[0.9375rem] max-w-[38ch]">
        ¿No encuentras tu caso? Escríbenos y te respondemos con una valoración
        inicial sin costo.
      </p>
    </div>

    <div class="lg:col-span-8 border-t border-line" data-reveal-stagger="45">
      {faq.map((item, i) => (
        <details class="group border-b border-line" open={i === 0} data-reveal>
          <summary
            class="flex items-start justify-between gap-8 py-6 cursor-pointer list-none select-none"
          >
            <h3 class="font-display text-[1.15rem] lg:text-[1.3rem] font-medium leading-snug transition-colors duration-300 group-hover:text-bronze-ink">
              {item.q}
            </h3>
            <span
              class="shrink-0 mt-1 text-bronze-ink transition-transform duration-400 ease-out group-open:rotate-45"
            >
              <Icon name="plus" size={20} stroke={1.4} />
            </span>
          </summary>
          <p class="text-slate leading-relaxed pb-7 max-w-[62ch] -mt-1">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
