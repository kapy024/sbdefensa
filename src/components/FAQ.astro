---
import { faq } from "../data/site";
---

<section class="py-20 bg-bone-warm">
  <div class="container-prose">
    <div class="max-w-2xl mb-12">
      <p class="eyebrow mb-3">Preguntas frecuentes</p>
      <h2 class="text-4xl md:text-5xl">Lo que más nos preguntan.</h2>
    </div>

    <div class="max-w-3xl divide-y divide-mist border-y border-mist">
      {faq.map((item, i) => (
        <details class="group" open={i === 0}>
          <summary class="flex items-start justify-between gap-6 py-6 cursor-pointer list-none">
            <h3 class="text-lg md:text-xl font-display group-hover:text-gold-dark transition-colors">
              {item.q}
            </h3>
            <span class="shrink-0 mt-1 text-gold-dark text-2xl group-open:rotate-45 transition-transform leading-none">
              +
            </span>
          </summary>
          <p class="text-slate leading-relaxed pb-6 max-w-2xl">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
