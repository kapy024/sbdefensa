---
import { team } from "../data/site";

interface Props {
  detailed?: boolean;
}
const { detailed = false } = Astro.props;
---

<section class="py-20">
  <div class="container-prose">
    <div class="max-w-2xl mb-12">
      <p class="eyebrow mb-3">Dirección</p>
      <h2 class="text-4xl md:text-5xl mb-4">Quienes están detrás del despacho.</h2>
      {!detailed && (
        <p class="text-slate">
          La dirección de SBDefensa la conforman dos socios con perfiles
          complementarios en defensa fiscal, contable y administrativa.
        </p>
      )}
    </div>

    <div class="grid gap-10 md:grid-cols-2">
      {team.map((m) => (
        <article class="bg-bone-warm p-8 lg:p-10">
          <div class="aspect-square w-24 bg-ink text-bone flex items-center justify-center mb-6 font-display text-3xl">
            {m.name.split(" ").slice(0, 2).map((n) => n[0]).join("")}
          </div>
          <h3 class="text-2xl leading-tight mb-1">{m.name}</h3>
          <p class="eyebrow mb-4">{m.role}</p>
          <p class="text-sm text-slate font-medium mb-2">{m.title}</p>
          <p class="text-xs text-slate uppercase tracking-wider mb-5">
            {m.specialties}
          </p>
          {m.bio.map((p) => (
            <p class="text-sm text-ink leading-relaxed mb-3">{p}</p>
          ))}
          {detailed && m.credentials.length > 0 && (
            <>
              <div class="gold-rule my-6"></div>
              <p class="eyebrow mb-3">Trayectoria</p>
              <ul class="space-y-2 text-sm text-slate">
                {m.credentials.map((c) => (
                  <li class="flex gap-3">
                    <span class="text-gold-dark mt-1">▪</span>
                    <span>{c}</span>
                  </li>
                ))}
              </ul>
            </>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
