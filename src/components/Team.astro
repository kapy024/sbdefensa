---
import { team } from "../data/site";

interface Props {
  detailed?: boolean;
}
const { detailed = false } = Astro.props;

const initials = (name: string) =>
  name.split(" ").slice(0, 2).map((n) => n[0]).join("");
---

<section class="py-section">
  <div class="shell">
    <div class="max-w-2xl mb-14" data-reveal>
      <p class="eyebrow mb-5">Dirección</p>
      <h2 data-split data-split-step="34" class="text-h2 font-light mb-5">Quienes están detrás del despacho.</h2>
      {!detailed && (
        <p class="text-slate leading-relaxed max-w-[52ch]">
          La dirección de SBDefensa la conforman dos socios con perfiles
          complementarios en defensa fiscal, contable y administrativa.
        </p>
      )}
    </div>

    <div class="grid gap-8 md:grid-cols-2 items-start" data-reveal-stagger="110">
      {team.map((m) => (
        <article class="bg-bone border border-mist p-9 lg:p-11 flex flex-col" data-reveal>
          <!-- Monogram seal: a printed ex-libris, not a photo placeholder. -->
          <div class="relative w-20 h-20 mb-8 shrink-0">
            <div class="absolute inset-0 border border-gold/70"></div>
            <div class="absolute inset-[5px] border border-gold/35"></div>
            <span
              class="absolute inset-0 grid place-items-center font-display text-2xl tracking-[0.06em] text-gold-ink"
            >
              {initials(m.name)}
            </span>
          </div>

          <h3 class="text-h3 font-normal leading-tight mb-2.5">{m.name}</h3>
          <p class="eyebrow mb-6">{m.role}</p>

          <p class="text-[0.9375rem] font-medium text-ink mb-1.5">{m.title}</p>
          <p class="text-xs text-slate uppercase tracking-[0.14em] mb-7">{m.specialties}</p>

          {m.bio.map((p) => (
            <p class="text-[0.9375rem] text-slate leading-relaxed mb-4">{p}</p>
          ))}

          {m.credentials.length > 0 && (
            <div class="pt-8">
              <div class="rule-gold mb-7"></div>
              <p class="eyebrow mb-6">Trayectoria</p>
              <ol class="space-y-4">
                {m.credentials.map((c, i) => (
                  <li class="flex gap-4 text-[0.9375rem] leading-relaxed">
                    <span class="font-display text-xs tracking-[0.2em] text-gold-ink/70 pt-1.5 tnum shrink-0">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <span class="text-slate">{c}</span>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
