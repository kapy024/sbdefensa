---
import { site, services, offices } from "../data/site";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
const waHref = `https://wa.me/${site.whatsapp}`;
const half = Math.ceil(services.length / 2);
---

<footer class="bg-parchment border-t border-ink/10 relative overflow-hidden">
  <div
    class="aura absolute -z-0 -bottom-56 left-[-8rem] w-[42rem] h-[42rem] rounded-full blur-3xl pointer-events-none"
    style="background: radial-gradient(circle, color-mix(in srgb, var(--color-bronze) 20%, transparent) 0%, transparent 68%);"
  >
  </div>

  <div class="shell relative z-10 pt-section-sm pb-12">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-x-14">
      <div class="lg:col-span-4">
        <img src="/logo.png" alt={site.legalName} width="200" height="56" class="h-12 w-auto mb-7" />
        <p class="text-[0.9375rem] text-slate leading-relaxed max-w-[34ch]">
          {site.legalName}. Firma fundada en {site.foundedYear}.
        </p>
        <div class="rule-bronze my-7 max-w-[12rem]"></div>
        <p class="text-[0.6875rem] uppercase tracking-[0.18em] text-slate">{site.coverage}</p>
      </div>

      <nav class="lg:col-span-5 grid grid-cols-2 gap-x-8" aria-label="Áreas de práctica">
        <div>
          <h2 class="text-[0.6875rem] uppercase tracking-[0.18em] text-bronze-ink mb-5">Servicios</h2>
          <ul class="space-y-3 text-[0.9375rem] text-slate">
            {services.slice(0, half).map((s) => (
              <li>
                <a href={`/servicios/${s.slug}/`} class="link-line hover:text-ink transition-colors">{s.name}</a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="text-[0.6875rem] uppercase tracking-[0.18em] text-bronze-ink mb-5">Más áreas</h2>
          <ul class="space-y-3 text-[0.9375rem] text-slate">
            {services.slice(half).map((s) => (
              <li>
                <a href={`/servicios/${s.slug}/`} class="link-line hover:text-ink transition-colors">{s.name}</a>
              </li>
            ))}
          </ul>
          <h2 class="text-[0.6875rem] uppercase tracking-[0.18em] text-bronze-ink mt-8 mb-5">Firma</h2>
          <ul class="space-y-3 text-[0.9375rem] text-slate">
            <li><a href="/nosotros/" class="link-line hover:text-ink transition-colors">Nosotros</a></li>
            <li><a href="/contacto/" class="link-line hover:text-ink transition-colors">Contacto</a></li>
          </ul>
        </div>
      </nav>

      <div class="lg:col-span-3">
        <h2 class="text-[0.6875rem] uppercase tracking-[0.18em] text-bronze-ink mb-5">Contacto</h2>
        <ul class="space-y-4 text-sm text-slate">
          <li>
            <a href={`mailto:${site.email}`} class="flex items-start gap-3 hover:text-ink transition-colors">
              <Icon name="mail" size={17} stroke={1.3} class="mt-0.5 shrink-0 text-bronze-ink" />
              <span class="[overflow-wrap:anywhere]">{site.email}</span>
            </a>
          </li>
          <li>
            <a href={waHref} target="_blank" rel="noopener" class="flex items-center gap-3 hover:text-ink transition-colors">
              <Icon name="whatsapp" size={16} class="text-bronze-ink" />
              {site.whatsappDisplay}
            </a>
          </li>
        </ul>

        <h2 class="text-[0.6875rem] uppercase tracking-[0.18em] text-bronze-ink mt-8 mb-5">Sedes</h2>
        <ul class="space-y-2.5 text-[0.9375rem] text-slate">
          {offices.map((o) => (
            <li class="flex items-center gap-2.5">
              <span class="h-px w-3 bg-bronze"></span>
              {o.city}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-ink/10 relative z-10">
    <div class="shell py-6 flex flex-col sm:flex-row gap-3 justify-between items-start sm:items-center text-xs text-slate">
      <p>© {year} {site.legalName}. Todos los derechos reservados.</p>
      <a href="/aviso-de-privacidad/" class="link-line hover:text-ink transition-colors">Aviso de Privacidad</a>
    </div>
  </div>
</footer>
