---
/** Masthead de páginas internas: misma fotografía a sangre y duotono verde
 *  que el hero de inicio, más corto. Unsplash "grand stone columns, classical interior". */
interface Props {
  eyebrow: string;
  index?: string;
  back?: { href: string; label: string };
  image?: string;
}
const {
  eyebrow, index, back,
  image = "https://images.unsplash.com/photo-1775144657294-8b170edbb526?auto=format&fit=crop&w=2400&q=72",
} = Astro.props;
---

<section class="relative isolate overflow-hidden bg-ink text-paper">
  <figure class="absolute inset-0 -z-10 m-0" aria-hidden="true">
    <img
      src={image}
      alt=""
      width="2400"
      height="1400"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover object-center grayscale contrast-[1.08] brightness-[0.9]"
    />
    <div class="absolute inset-0 bg-forest mix-blend-color"></div>
    <div class="absolute inset-0 bg-ink mix-blend-multiply opacity-40"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_top,var(--color-ink)_0%,color-mix(in_srgb,var(--color-ink)_70%,transparent)_35%,transparent_75%)]"></div>
  </figure>

  <div class="shell relative pt-28 pb-14 lg:pt-36 lg:pb-20">
    {back && (
      <a href={back.href} class="link-line inline-flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.18em] text-bronze-light mb-10">
        <span aria-hidden="true">&larr;</span> {back.label}
      </a>
    )}

    <div class="flex items-start justify-between gap-8 mb-6">
      <p class="font-mono text-[0.75rem] tracking-[0.18em] uppercase text-bronze-light">{eyebrow}</p>
      {index && <span class="font-mono text-[0.75rem] tracking-[0.2em] text-paper/50">{index}</span>}
    </div>

    <h1 data-split data-split-step="40" class="text-h1 font-display font-normal text-paper max-w-[18ch] mb-8">
      <slot name="title" />
    </h1>

    <div class="h-px w-full max-w-sm bg-bronze/60 mb-8"></div>

    <div class="text-lead text-paper/75 max-w-[58ch] leading-relaxed">
      <slot />
    </div>
  </div>
</section>
