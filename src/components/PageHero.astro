---
/** Masthead de páginas internas: papel con malla, no bloque de tinta. */
interface Props {
  eyebrow: string;
  index?: string;
  back?: { href: string; label: string };
}
const { eyebrow, index, back } = Astro.props;
---

<section class="relative overflow-hidden border-b border-ink/10">
  <div class="absolute inset-0 -z-10 paper-panel"></div>
  <div
    class="aura absolute -z-10 -top-40 right-[-8rem] w-[40rem] h-[40rem] rounded-full blur-3xl pointer-events-none"
    style="background: radial-gradient(circle, color-mix(in srgb, var(--color-bronze) 30%, transparent) 0%, transparent 68%);"
  >
  </div>

  <div class="shell relative pt-14 pb-16 lg:pt-20 lg:pb-24">
    {back && (
      <a
        href={back.href}
        class="link-line inline-flex items-center gap-2 text-[0.6875rem] uppercase tracking-[0.18em] text-bronze-ink font-semibold mb-10"
      >
        <span aria-hidden="true">&larr;</span> {back.label}
      </a>
    )}

    <div class="flex items-start justify-between gap-8">
      <p class="eyebrow mb-7">{eyebrow}</p>
      {index && (
        <span class="font-display text-xs tracking-[0.3em] text-slate pt-1">{index}</span>
      )}
    </div>

    <h1 data-split data-split-step="40" class="text-h1 font-light max-w-[18ch] mb-8">
      <slot name="title" />
    </h1>

    <div class="rule-bronze mb-8 max-w-sm"></div>

    <div class="text-lead text-slate max-w-[58ch] leading-relaxed">
      <slot />
    </div>
  </div>
</section>
