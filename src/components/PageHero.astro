---
/** Masthead for inner pages: ink panel, eyebrow, display title, lead. */
interface Props {
  eyebrow: string;
  index?: string;
  back?: { href: string; label: string };
}
const { eyebrow, index, back } = Astro.props;
---

<section class="on-ink ink-panel text-bone">
  <div class="shell pt-14 pb-16 lg:pt-20 lg:pb-24">
    {back && (
      <a
        href={back.href}
        class="link-line inline-flex items-center gap-2 text-[0.6875rem] uppercase tracking-[0.18em] text-gold-light mb-10"
      >
        <span aria-hidden="true">&larr;</span> {back.label}
      </a>
    )}

    <div class="flex items-start justify-between gap-8">
      <p class="eyebrow mb-7">{eyebrow}</p>
      {index && (
        <span class="font-display text-xs tracking-[0.3em] text-bone/60 pt-1">{index}</span>
      )}
    </div>

    <h1 class="text-h1 font-light text-bone max-w-[18ch] mb-8">
      <slot name="title" />
    </h1>

    <div class="rule-gold mb-8 max-w-sm"></div>

    <div class="text-lead text-bone/75 max-w-[58ch] leading-relaxed">
      <slot />
    </div>
  </div>
</section>
