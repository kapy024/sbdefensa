---
import { site } from "../data/site";
import Icon from "./Icon.astro";

const waHref = `https://wa.me/${site.whatsapp}`;
---

<section class="py-section-sm">
  <div class="shell">
    <!-- La urgencia ya no se pinta de negro: se pinta de oro. Tinta sobre
         oro da 6:1 o más, así que el contraste sube en vez de bajar. -->
    <div
      class="texture-marble texture-marble-light rounded-[var(--radius-xl)] p-10 lg:p-16 relative overflow-hidden shadow-lift"
      style="background: linear-gradient(135deg, var(--color-bronze-light) 0%, var(--color-bronze) 52%, var(--color-bronze) 100%);"
      data-reveal
    >
      <div
        class="aura absolute inset-0 pointer-events-none opacity-60"
        style="background: radial-gradient(70% 90% at 88% 8%, color-mix(in srgb, white 45%, transparent) 0%, transparent 62%);"
      >
      </div>

      <div class="relative max-w-3xl">
        <p class="flex items-center gap-3 text-[0.6875rem] font-semibold uppercase tracking-[0.2em] text-ink mb-6">
          <span class="h-px w-7 bg-ink/40"></span>
          ¿Tienes un asunto urgente?
        </p>

        <h2 data-split data-split-step="34" class="text-h2 font-light text-ink mb-7 leading-[1.08]">
          Los plazos para impugnar son fatales.
          <span class="block italic">No los dejes correr.</span>
        </h2>

        <div class="h-px w-full max-w-sm bg-ink/25 mb-8"></div>

        <p class="text-ink/85 leading-relaxed mb-9 text-lead max-w-xl">
          Si recibiste una notificación del SAT, IMSS, INFONAVIT o aduana,
          contáctanos cuanto antes. La primera valoración es sin costo.
        </p>

        <div class="flex flex-wrap gap-3">
          <a href="/contacto/" class="btn btn-primary">
            Solicita asesoría
            <Icon name="arrow-right" size={17} stroke={1.5} />
          </a>
          <a
            href={waHref}
            target="_blank"
            rel="noopener"
            class="btn bg-transparent text-ink border-ink/35 hover:bg-ink hover:text-paper hover:border-ink"
          >
            <Icon name="whatsapp" size={17} />
            WhatsApp directo
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
