---
import { site } from "../data/site";
import Icon from "./Icon.astro";

const waHref = `https://wa.me/${site.whatsapp}`;
---

<section class="py-section-sm">
  <div class="shell">
    <div class="on-ink ink-panel ink-panel-edge rounded-[var(--radius-xl)] text-bone p-10 lg:p-16 relative overflow-hidden" data-reveal>
      <div class="relative max-w-3xl">
        <p class="eyebrow mb-6">¿Tienes un asunto urgente?</p>

        <h2 data-split data-split-step="34" class="text-h2 font-light text-bone mb-7 leading-[1.08]">
          Los plazos para impugnar son fatales.
          <span class="block italic text-gold">No los dejes correr.</span>
        </h2>

        <div class="rule-gold mb-8 max-w-sm"></div>

        <p class="text-bone/75 leading-relaxed mb-9 text-lead max-w-xl">
          Si recibiste una notificación del SAT, IMSS, INFONAVIT o aduana,
          contáctanos cuanto antes. La primera valoración es sin costo.
        </p>

        <div class="flex flex-wrap gap-3">
          <a href="/contacto/" class="btn btn-gold">
            Solicita asesoría
            <Icon name="arrow-right" size={17} stroke={1.5} />
          </a>
          <a href={waHref} target="_blank" rel="noopener" class="btn btn-on-ink">
            <Icon name="whatsapp" size={17} />
            WhatsApp directo
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
