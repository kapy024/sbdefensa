---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Contact from "../components/Contact.astro";
---

<Layout
  title="Contacto"
  canonicalPath="/contacto/"
  description="Contacta a SBDefensa para una valoración inicial sin costo. Atendemos a contribuyentes y empresas en toda la República Mexicana."
>
  <PageHero eyebrow="Contacto">
    <span slot="title">
      Hablemos <span class="italic text-bronze-ink">de tu caso.</span>
    </span>
    Una llamada o un mensaje pueden marcar la diferencia entre una defensa
    oportuna y una resolución firme. Contáctanos por el medio que prefieras.
  </PageHero>

  <Contact compact />
</Layout>
